@model HospitalSystem.Models.Appointment

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white text-center">
            <h4>Book Appointment with Dr. @ViewBag.DoctorName</h4>
        </div>
        <div class="card-body">
            <form asp-action="Book" method="post">
                <input type="hidden" asp-for="DoctorId" />

                <div class="mb-3">
                    <label class="form-label">Patient Name</label>
                    <input asp-for="PatientName" class="form-control" required />
                    <span asp-validation-for="PatientName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Date (Sun - Thu)</label>
                    <input asp-for="Date" type="date" class="form-control" required />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Time (9:00 AM - 4:30 PM)</label>
                    <input asp-for="Time" type="time" step="1800" class="form-control" required />
                    <span asp-validation-for="Time" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success w-100 mt-3">Confirm Booking</button>
            </form>
        </div>
    </div>
</div>