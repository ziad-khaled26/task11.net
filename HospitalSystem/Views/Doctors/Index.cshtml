@model IEnumerable<HospitalSystem.Models.Doctor>

<h2 class="text-center text-primary mb-4">Our Doctors</h2>

<form method="get" class="mb-4 d-flex gap-2 justify-content-center">
    <input type="text" name="searchName" class="form-control w-25" placeholder="Doctor Name..." />
    <input type="text" name="specialization" class="form-control w-25" placeholder="Specialization..." />
    <button type="submit" class="btn btn-success">Filter</button>
</form>

<div class="row">
    @foreach (var doctor in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <img src="~/images/@doctor.ImagePath" class="card-img-top" alt="@doctor.Name" style="height: 250px; object-fit: cover;">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Dr. @doctor.Name</h5>
                    <p class="card-text text-muted">@doctor.Specialization</p>
                    <a href="/Appointments/Book?doctorId=@doctor.Id" class="btn btn-primary w-100">Book Appointment</a>
                </div>
            </div>
        </div>
    }
</div>